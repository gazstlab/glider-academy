# =============================================================
# Glider — glider.academy
# Stack: pnpm · Vite · React · TypeScript · Python/Pyodide ·
#        Vitest · Playwright
# =============================================================

# ---------- Dependencies ----------
node_modules/
.pnpm-store/
.yarn/

# ---------- Build ----------
dist/
build/
.vite/
*.tsbuildinfo

# Pyodide runtime, downloaded at build time. Large and reproducible.
# Do NOT ignore *.whl: if the Python shim is vendored as a pinned
# wheel, it has to be version-controlled.
public/pyodide/

# ---------- Tests ----------
coverage/
playwright-report/
test-results/
blob-report/
.playwright/
*.actual.png
*.diff.png

# ---------- Python ----------
__pycache__/
*.py[cod]
.venv/
venv/
.ruff_cache/
.pytest_cache/
.mypy_cache/

# ---------- Environment ----------
# .env.example is version-controlled on purpose.
.env
.env.*
!.env.example

# ---------- Deploy ----------
.vercel/
.wrangler/

# ---------- Claude Code ----------
# settings.json is the team contract and DOES go into the repository.
# settings.local.json is a per-machine preference and does not.
.claude/settings.local.json

# ---------- Editor and OS ----------
.DS_Store
.AppleDouble
.idea/
.vscode/*
!.vscode/extensions.json

# ---------- Logs ----------
*.log
npm-debug.log*
pnpm-debug.log*
