{
  "$meta": {
    "name": "Glider Design System",
    "version": "2.0.0",
    "site": "glider.academy",
    "lineage": "Descende da identidade do Apache Airflow: marca #017CEE, cores de estado de airflow.utils.state, estrutura de tokens espelhando a UI do Airflow 3 (Chakra).",
    "note": "Espelho de tokens.css. Em caso de divergencia, tokens.css vence.",
    "trademark": "Apache Airflow e marca da Apache Software Foundation. Este projeto nao e afiliado a ASF."
  },
  "color": {
    "brand": {
      "50": "#E8F3FE",
      "100": "#C7E2FD",
      "200": "#92C8FB",
      "300": "#4FA6F5",
      "400": "#1A8CF1",
      "500": "#017CEE",
      "600": "#0163C0",
      "700": "#014E97",
      "800": "#013A70",
      "900": "#01294F",
      "950": "#011A33"
    },
    "gray": {
      "0": "#FFFFFF",
      "50": "#F7F9FB",
      "100": "#EDF1F5",
      "200": "#DCE3EB",
      "300": "#C2CDD9",
      "400": "#9AA8B8",
      "500": "#71829A",
      "600": "#55677E",
      "700": "#3E4E62",
      "800": "#2A3646",
      "900": "#1B2431",
      "950": "#10161F"
    },
    "semantic": {
      "light": {
        "bg": "#F7F9FB",
        "surface": "#FFFFFF",
        "surfaceRaised": "#EDF1F5",
        "border": "#DCE3EB",
        "borderStrong": "#C2CDD9",
        "text": "#1B2431",
        "textMuted": "#55677E",
        "accent": "#017CEE",
        "accentHover": "#0163C0",
        "accentQuiet": "#E8F3FE",
        "onAccent": "#FFFFFF"
      },
      "dark": {
        "bg": "#10161F",
        "surface": "#1B2431",
        "surfaceRaised": "#2A3646",
        "border": "#2A3646",
        "borderStrong": "#3E4E62",
        "text": "#EDF1F5",
        "textMuted": "#9AA8B8",
        "accent": "#1A8CF1",
        "accentHover": "#4FA6F5",
        "accentQuiet": "#01294F",
        "onAccent": "#041424"
      }
    },
    "taskState": {
      "$note": "Chave = estado de airflow.utils.state. airflowColor = cor nomeada CSS original, mantida como referencia de matiz.",
      "none": {
        "airflowColor": "lightblue",
        "light": "#3E7FB8",
        "dark": "#7FC4EE",
        "glyph": "vazio"
      },
      "scheduled": {
        "airflowColor": "tan",
        "light": "#8A6A3E",
        "dark": "#D0B084",
        "glyph": "ponto"
      },
      "queued": {
        "airflowColor": "gray",
        "light": "#6B7A90",
        "dark": "#8A9AB0",
        "glyph": "quadrado vazado"
      },
      "running": {
        "airflowColor": "lime",
        "light": "#3BC44B",
        "dark": "#57E06A",
        "glyph": "anel pulsando"
      },
      "success": {
        "airflowColor": "green",
        "light": "#14804A",
        "dark": "#34C77B",
        "glyph": "check"
      },
      "failed": {
        "airflowColor": "red",
        "light": "#C1272D",
        "dark": "#F2646A",
        "glyph": "x"
      },
      "up_for_retry": {
        "airflowColor": "gold",
        "light": "#B26A00",
        "dark": "#F2B23C",
        "glyph": "seta circular"
      },
      "up_for_reschedule": {
        "airflowColor": "turquoise",
        "light": "#0E8A8F",
        "dark": "#35D0D6",
        "glyph": "relogio"
      },
      "upstream_failed": {
        "airflowColor": "orange",
        "light": "#C2410C",
        "dark": "#FB8B4C",
        "glyph": "seta para cima"
      },
      "skipped": {
        "airflowColor": "hotpink",
        "light": "#C2186C",
        "dark": "#FF77B4",
        "glyph": "barra"
      },
      "deferred": {
        "airflowColor": "mediumpurple",
        "light": "#6B4EC7",
        "dark": "#A98BF5",
        "glyph": "pausa"
      },
      "restarting": {
        "airflowColor": "violet",
        "light": "#9333C7",
        "dark": "#D07BF5",
        "glyph": "seta circular dupla"
      },
      "removed": {
        "airflowColor": "lightgrey",
        "light": "#9AA5B4",
        "dark": "#4A5568",
        "glyph": "hachura"
      }
    },
    "rules": [
      "O azul de marca nunca e cor de estado.",
      "Estado = cor + glifo + texto acessivel.",
      "Nenhum estado fora de airflow.utils.state."
    ]
  },
  "typography": {
    "family": {
      "display": "Familjen Grotesk",
      "body": "Inter",
      "mono": "JetBrains Mono"
    },
    "size": {
      "2xs": "0.6875rem",
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.25rem",
      "xl": "1.75rem",
      "2xl": "2.5rem",
      "3xl": "3.5rem",
      "4xl": "4.5rem"
    },
    "leading": {
      "tight": 1.08,
      "snug": 1.35,
      "body": 1.6
    },
    "tracking": {
      "display": "-0.025em",
      "label": "0.12em"
    }
  },
  "space": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "6": "1.5rem",
    "8": "2rem",
    "12": "3rem",
    "16": "4rem",
    "24": "6rem"
  },
  "layout": {
    "maxWidth": "1200px",
    "proseWidth": "68ch",
    "breakpoints": {
      "sm": "640px",
      "md": "900px",
      "lg": "1200px"
    }
  },
  "grid": {
    "cellSize": "14px",
    "cellGap": "3px",
    "cellRadius": "2px"
  },
  "radius": {
    "cell": "2px",
    "node": "3px",
    "ui": "6px",
    "card": "8px",
    "pill": "999px"
  },
  "shadow": {
    "card": "0 1px 2px rgb(16 22 31 / 0.06), 0 1px 3px rgb(16 22 31 / 0.04)",
    "pop": "0 4px 12px rgb(16 22 31 / 0.10)",
    "ringFocus": "0 0 0 2px var(--gl-bg), 0 0 0 4px var(--gl-focus)"
  },
  "motion": {
    "easing": {
      "out": "cubic-bezier(0.16, 1, 0.3, 1)",
      "snap": "cubic-bezier(0.22, 0.61, 0.36, 1)"
    },
    "duration": {
      "1": "120ms",
      "2": "200ms",
      "3": "320ms",
      "pulse": "1600ms",
      "spin": "6000ms"
    },
    "rule": "Somente o estado running pulsa. O cata-vento do hero gira uma volta na carga."
  },
  "signature": {
    "element": "grid de estados (linha = task, coluna = run)",
    "scales": [
      "hero: 15 celulas = a trilha",
      "indice: licoes x tentativas",
      "lab: o DAG run real"
    ],
    "rule": "Progresso e coluna do grid. Barra de porcentagem nao existe no produto."
  }
}
